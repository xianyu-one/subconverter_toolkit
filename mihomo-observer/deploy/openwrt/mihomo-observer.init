#!/bin/sh /etc/rc.common

USE_PROCD=1
START=95
STOP=05

start_service() {
	local config_file
	config_file="$(uci -q get mihomo-observer.main.config_file)"
	[ -n "$config_file" ] || config_file=/etc/mihomo-observer/config.yaml
	[ -r "$config_file" ] || {
		logger -t mihomo-observer "configuration is not readable: $config_file"
		return 1
	}

	procd_open_instance
	procd_set_param command /usr/bin/mihomo-observer
	procd_set_param env MIHOMO_OBSERVER_CONFIG="$config_file"
	procd_set_param file "$config_file"
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger mihomo-observer
}
